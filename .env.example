# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
#
# Local development or direct AWS RDS connection
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable
DB_SSLROOTCERT=
DATABASE_URL=

# AWS RDS / Aurora PostgreSQL via Secrets Manager
# Option 1:
#   Set the DB_* values above to your AWS database endpoint values.
#   For AWS, usually set DB_SSLMODE=require.
# Option 2:
#   Set AWS_SECRETS_MANAGER_SECRET_NAME and store JSON with these keys:
#   {
#     "DB_HOST": "your-rds-endpoint.amazonaws.com",
#     "DB_PORT": "5432",
#     "DB_NAME": "student_management",
#     "DB_USER": "postgres",
#     "DB_PASSWORD": "your-password",
#     "DB_SSLMODE": "require"
#   }
#   You can also store DATABASE_URL instead of separate DB_* values.
AWS_SECRETS_MANAGER_SECRET_NAME=
AWS_REGION=us-east-1
