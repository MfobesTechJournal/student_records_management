# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
#
# ── Local development ─────────────────────────────────────────────────────────
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5433

# ── AWS (production) ─────────────────────────────────────────────────────────
# Set this to your AWS Secrets Manager secret name.
# When set, all DB_* variables above are ignored and fetched from Secrets Manager.
AWS_SECRETS_MANAGER_SECRET_NAME=
AWS_REGION=us-east-1
